{
  "name": "codeex-v2",
  "version": "0.1.0",
  "description": "CodeEX v2 — Sovereign IDE by TerraTech Systems. Clean-sheet build: CodeMirror 6 + SolidJS + TerraRuntime.",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/app dev",
    "dev:desktop": "bun run --cwd packages/desktop tauri dev",
    "build": "bun run --cwd packages/app build",
    "build:desktop": "bun run --cwd packages/desktop tauri build",
    "preview": "bun run --cwd packages/app preview",
    "typecheck": "tsc --noEmit"
  },
  "author": "TerraTech Systems",
  "license": "PROPRIETARY"
}
